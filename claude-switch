#!/usr/bin/env bash
# claude-switch — Claude Code account profile switcher (copy-based, no symlinks)
#
# Account identity is defined by a pair of files that must match:
#   ~/.claude.json              -> oauthAccount (email / account UUID / org UUID)
#   ~/.claude/.credentials.json -> actual OAuth token + organizationUuid
# This script keeps per-profile copies of both files and swaps them as a pair on switch.
# Before switching, it writes the current live state back to the active profile
# so that any refreshed tokens are preserved.
set -euo pipefail

CRED="$HOME/.claude/.credentials.json"
CONF="$HOME/.claude.json"
MARK="$HOME/.claude/.active-profile"

die(){ echo "✗ $*" >&2; exit 1; }
active(){ [ -f "$MARK" ] && cat "$MARK" || echo unknown; }
# Saved profiles = existing .claude.json.<name> files
profiles(){ for f in "$CONF".*; do [ -f "$f" ] || continue; b="${f##*/.claude.json.}"; case "$b" in real.*) ;; *) echo "$b";; esac; done; }
email_of(){
  python3 - "$1" <<'PY' 2>/dev/null || echo '?'
import json, sys
print(json.load(open(sys.argv[1])).get('oauthAccount', {}).get('emailAddress', '?'))
PY
}
usage_of(){
  local cred_file="$1"
  [ -f "$cred_file" ] || { printf "cred:x"; return; }
  local token resp
  token=$(python3 -c "
import json, sys
d = json.load(open(sys.argv[1]))
print(d.get('claudeAiOauth', {}).get('accessToken', ''))
" "$cred_file" 2>/dev/null)
  [ -n "$token" ] || { printf "cred:o  usage:?"; return; }
  resp=$(curl -s --max-time 5 "https://claude.ai/api/oauth/usage" \
    -H "Authorization: Bearer $token" \
    -H "Content-Type: application/json" \
    -H "User-Agent: Claude-Code/1.0" \
    -H "X-Frame-Surface: code" \
    --cookie "sessionKey=$token" 2>/dev/null)
  python3 -c "
import json, sys
try:
    d = json.loads(sys.argv[1])
    fh = (d.get('five_hour') or {}).get('utilization', '?')
    sd = (d.get('seven_day') or {}).get('utilization', '?')
    fh_s = f'{int(fh):>3}%' if isinstance(fh, (int,float)) else ' ?%'
    sd_s = f'{int(sd):>3}%' if isinstance(sd, (int,float)) else ' ?%'
    print(f'cred:o  5h:{fh_s}  7d:{sd_s}')
except Exception as e:
    print('cred:o  usage:?')
" "$resp" 2>/dev/null || printf "cred:o  usage:?"
}

[ $# -ge 1 ] || { echo "usage: claude-switch [personal|teams|status|save <name>]"; exit 1; }
cmd="$1"

# Snapshot the currently logged-in account under an arbitrary profile name (for bootstrapping a new machine)
if [ "$cmd" = save ]; then
  name="${2:-}"; [ -n "$name" ] || die "usage: claude-switch save <name>"
  [ -f "$CONF" ] || die "config not found: $CONF"
  [ -f "$CRED" ] || die "credentials not found: run 'claude' and /login first"
  # Resolve symlink to real file if needed
  if [ -L "$CONF" ]; then real=$(readlink -f "$CONF"); cp -f "$real" "$CONF.real.$$"; rm -f "$CONF"; mv "$CONF.real.$$" "$CONF"; fi
  cp -f "$CONF" "$CONF.$name"; chmod 600 "$CONF.$name"
  cp -f "$CRED" "$CRED.$name"; chmod 600 "$CRED.$name"
  echo "$name" > "$MARK"
  echo "✓ current account ($(email_of "$CONF")) saved as profile [$name]"
  exit 0
fi

if [ "$cmd" = status ]; then
  cur=$(active)
  echo "active profile : $cur"
  echo "config account : $(email_of "$CONF")"
  for p in $(profiles); do
    conf_mark="$([ -f "$CONF.$p" ] && echo o || echo x)"
    if [ -f "$CRED.$p" ]; then
      [ "$p" = "$cur" ] && cred_src="$CRED" || cred_src="$CRED.$p"
      printf '  - %-10s config:%s  %s\n' "$p" "$conf_mark" "$(usage_of "$cred_src")"
    else
      printf '  - %-10s config:%s  cred:x\n' "$p" "$conf_mark"
    fi
  done
  exit 0
fi

profiles | grep -Fqx "$cmd" || die "unknown profile: $cmd (saved profiles: $(profiles | tr '\n' ' '))"
target="$cmd"

# Prevent concurrent execution
exec 9>"$HOME/.claude/.switch.lock"
flock -n 9 || die "another claude-switch is already running"

# 1) Refuse to switch if Claude Code is running (it overwrites .claude.json on exit, clobbering the swap)
if pgrep -x claude >/dev/null 2>&1 || pgrep -af node 2>/dev/null | grep -q "[c]laude"; then
  die "Claude Code is running. Quit it fully before switching profiles."
fi

# 2) If config is a symlink, replace it with the real file (removes symlink dependency)
if [ -L "$CONF" ]; then
  real=$(readlink -f "$CONF"); cp -f "$real" "$CONF.real.$$"; rm -f "$CONF"; mv "$CONF.real.$$" "$CONF"
fi

# 3) Write the current live state back to the active profile (preserves refreshed tokens/settings)
cur=$(active)
if [ "$cur" != unknown ] && [ "$cur" != "$target" ]; then
  cp -f "$CONF" "$CONF.$cur"
  [ -f "$CRED" ] && cp -f "$CRED" "$CRED.$cur"
fi

# 4) Load the target profile
[ -f "$CONF.$target" ] || die "missing $CONF.$target"
cp -f "$CONF.$target" "$CONF"
if [ -f "$CRED.$target" ]; then
  cp -f "$CRED.$target" "$CRED"; chmod 600 "$CRED"
  echo "✓ switched to [$target]  ($(email_of "$CONF"))"
else
  rm -f "$CRED"
  echo "✓ config switched to [$target]. No saved token — run claude and /login."
  echo "  (the token will be saved automatically on the next profile switch)"
fi
echo "$target" > "$MARK"
