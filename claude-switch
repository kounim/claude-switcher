#!/usr/bin/env bash
# claude-switch — Claude Code account profile switcher (copy-based, no symlinks)
#
# Account identity lives in two places:
#   ~/.claude.json              -> oauthAccount (email / account UUID / org UUID); the rest is shared local state
#   ~/.claude/.credentials.json -> actual OAuth token
# Each profile keeps its oauthAccount (~/.claude.json.<name>) and credentials (~/.claude/.credentials.json.<name>).
# On switch, only oauthAccount is swapped inside ~/.claude.json, so projects/trust/permissions/MCP settings stay shared.
# Before switching, the live account state is written back to the profile that owns it (matched by account UUID)
# so that any refreshed tokens are preserved.
set -euo pipefail
umask 077

CRED="$HOME/.claude/.credentials.json"
CONF="$HOME/.claude.json"
MARK="$HOME/.claude/.active-profile"
LOCK="$HOME/.claude/.switch.lock"
prog="${0##*/}"

die(){ echo "✗ $*" >&2; exit 1; }
active(){ [ -f "$MARK" ] && cat "$MARK" || echo unknown; }
valid_name(){ [[ "$1" =~ ^[A-Za-z0-9_-]+$ ]]; }
copy_atomic(){ cp -f "$1" "$2.tmp.$$" && mv -f "$2.tmp.$$" "$2"; }
# Saved profiles = .claude.json.<name> with a matching .credentials.json.<name>
profiles(){ for f in "$CONF".*; do [ -f "$f" ] || continue; b="${f##*/.claude.json.}"; valid_name "$b" && [ -f "$CRED.$b" ] && echo "$b"; done; return 0; }

json_op(){
  python3 - "$@" <<'PY'
import json, os, sys

def load(p):
    with open(p) as f:
        return json.load(f)

def dump(p, d):
    tmp = f'{p}.tmp.{os.getpid()}'
    with open(tmp, 'w') as f:
        json.dump(d, f, indent=2)
    os.replace(tmp, p)

op, *a = sys.argv[1:]
if op == 'email':      # email <conf>
    print(load(a[0]).get('oauthAccount', {}).get('emailAddress', '?'))
elif op == 'uuid':     # uuid <conf>
    print(load(a[0]).get('oauthAccount', {}).get('accountUuid', ''))
elif op == 'extract':  # extract <live conf> <profile conf>: store live oauthAccount as the profile
    acct = load(a[0]).get('oauthAccount')
    if not acct:
        sys.exit(f'no oauthAccount in {a[0]}')
    dump(a[1], {'oauthAccount': acct})
elif op == 'apply':    # apply <profile conf> <live conf>: put profile oauthAccount into live config
    acct = load(a[0]).get('oauthAccount')
    if not acct:
        sys.exit(f'no oauthAccount in {a[0]}')
    d = load(a[1])
    d['oauthAccount'] = acct
    dump(a[1], d)
PY
}
email_of(){ json_op email "$1" 2>/dev/null || echo '?'; }
uuid_of(){ json_op uuid "$1" 2>/dev/null || true; }
profile_of_uuid(){
  local u="$1" p
  [ -n "$u" ] || return 1
  for p in $(profiles); do [ "$(uuid_of "$CONF.$p")" = "$u" ] && { echo "$p"; return 0; }; done
  return 1
}
# Running Claude Code processes as "PID cmdline" lines (empty if none)
claude_procs(){ { pgrep -ax claude; pgrep -af '@anthropic-ai/claude-code'; } 2>/dev/null | sort -u -k1,1n || true; }

usage_of(){
  local cred_file="$1" mode="${2:-refresh}"
  [ -f "$cred_file" ] || { printf "cred:x"; return; }
  python3 - "$cred_file" "$mode" <<'PY' 2>/dev/null || printf "cred:o  usage:?"
import json, os, sys, time, urllib.request, urllib.error

REFRESH_URL = 'https://platform.claude.com/v1/oauth/token'
USAGE_URL   = 'https://claude.ai/api/oauth/usage'
CLIENT_ID   = '9d1c250a-e61b-44d9-88ed-5944d1962f5e'

cred_file, mode = sys.argv[1], sys.argv[2]
d = json.load(open(cred_file))
oauth = d.get('claudeAiOauth', {})
access_token  = oauth.get('accessToken', '')
refresh_token = oauth.get('refreshToken', '')
expires_at    = oauth.get('expiresAt', 0)  # milliseconds

if not access_token:
    print('cred:o  usage:?')
    sys.exit(0)

if expires_at and time.time() * 1000 > expires_at:
    # Never refresh the live credentials: rotating the refresh token would invalidate the one Claude Code holds
    if mode != 'refresh' or not refresh_token:
        print('cred:o  usage:? (expired)')
        sys.exit(0)
    req = urllib.request.Request(
        REFRESH_URL,
        data=json.dumps({'grant_type': 'refresh_token',
                         'refresh_token': refresh_token,
                         'client_id': CLIENT_ID}).encode(),
        headers={'Content-Type': 'application/json',
                 'anthropic-version': '2023-06-01',
                 'User-Agent': 'Claude-Code/1.0'},
        method='POST'
    )
    try:
        with urllib.request.urlopen(req, timeout=10) as resp:
            r = json.loads(resp.read())
        if 'access_token' in r:
            oauth['accessToken'] = r['access_token']
            if 'refresh_token' in r:
                oauth['refreshToken'] = r['refresh_token']
            if 'expires_in' in r:
                oauth['expiresAt'] = int((time.time() + r['expires_in']) * 1000)
            d['claudeAiOauth'] = oauth
            tmp = f'{cred_file}.tmp.{os.getpid()}'
            with open(tmp, 'w') as f:
                json.dump(d, f, indent=2)
            os.replace(tmp, cred_file)
            access_token = r['access_token']
        else:
            print('cred:o  usage:?')
            sys.exit(0)
    except Exception:
        print('cred:o  usage:?')
        sys.exit(0)

# Fetch usage
req = urllib.request.Request(
    USAGE_URL,
    headers={'Authorization': f'Bearer {access_token}',
             'Content-Type': 'application/json',
             'User-Agent': 'Claude-Code/1.0',
             'X-Frame-Surface': 'code',
             'Cookie': f'sessionKey={access_token}'}
)
try:
    with urllib.request.urlopen(req, timeout=5) as resp:
        u = json.loads(resp.read())
    from datetime import datetime
    def window(key, fmt):
        w = u.get(key) or {}
        v = w.get('utilization')
        pct = f'{int(v):>3}%' if isinstance(v, (int, float)) else ' ?%'
        try:  # reset time in local time; omitted if missing (e.g. no usage in the window)
            reset = datetime.fromisoformat(w['resets_at']).astimezone().strftime(fmt)
            return f'{pct} (reset {reset})'
        except Exception:
            return pct
    print(f"cred:o  5h:{window('five_hour', '%H:%M')}  7d:{window('seven_day', '%m/%d %H:%M')}")
except Exception:
    print('cred:o  usage:?')
PY
}

usage(){
  cat <<EOF
usage: $prog [<profile>]
       $prog --status | --save <name> | --delete <name> | --help

  (no args)         same as --status
  <profile>         switch to a saved profile (Claude Code must be quit first)
  -s, --status      show saved profiles and 5h / 7d usage (* = active)
  --save <name>     save the currently logged-in account as a profile
  --delete <name>   delete a saved profile (not the active one)
  -h, --help        show this help

saved profiles: $(profiles | tr '\n' ' ')
EOF
}

# Options always start with '-' / '--'; a bare word is always a profile name
cmd="" name=""
set_cmd(){ [ -z "$cmd" ] || die "only one of <profile>, --status, --save, --delete may be given"; cmd="$1"; }
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0;;
    -s|--status) set_cmd status;;
    --save|--delete)
      set_cmd "${1#--}"
      [ $# -ge 2 ] || die "usage: $prog $1 <name>"
      name="$2"; shift;;
    -*) die "unknown option: $1 (see '$prog -h')";;
    *)
      case "$1" in status|save|delete|help) die "'$1' is now '--$1' (see '$prog -h')";; esac
      set_cmd switch; name="$1";;
  esac
  shift
done
[ -n "$cmd" ] || cmd=status

# Prevent concurrent execution
exec 9>"$LOCK"
flock -n 9 || die "another $prog is already running"

# Snapshot the currently logged-in account under an arbitrary profile name
if [ "$cmd" = save ]; then
  valid_name "$name" || die "invalid name: $name (use letters, digits, _ and -)"
  case "$name" in save|status|delete|help|-*) die "reserved name: $name";; esac
  [ -f "$CONF" ] || die "config not found: $CONF"
  [ -f "$CRED" ] || die "credentials not found: run 'claude' and /login first"
  json_op extract "$CONF" "$CONF.$name"
  copy_atomic "$CRED" "$CRED.$name"
  echo "$name" > "$MARK"
  echo "✓ current account ($(email_of "$CONF")) saved as profile [$name]"
  exit 0
fi

if [ "$cmd" = delete ]; then
  profiles | grep -Fqx "$name" || die "no such profile: $name"
  [ "$(active)" = "$name" ] && die "cannot delete the active profile; switch to another profile first"
  rm -f "$CONF.$name" "$CRED.$name"
  echo "✓ profile [$name] deleted"
  exit 0
fi

if [ "$cmd" = status ]; then
  cur=$(active)
  echo "active profile : $cur"
  echo "config account : $(email_of "$CONF")"
  # A Claude Code process missed by the running check may have written its old account back
  if [ -f "$CONF.$cur" ] && [ "$(uuid_of "$CONF")" != "$(uuid_of "$CONF.$cur")" ]; then
    echo "⚠ config account does not match profile [$cur] ($(email_of "$CONF.$cur"))." >&2
    echo "  A Claude Code process may have overwritten it; quit all Claude Code processes and switch again." >&2
  fi
  for p in $(profiles); do
    if [ "$p" = "$cur" ]; then
      printf '  * %-10s %s\n' "$p" "$(usage_of "$CRED" norefresh)"
    else
      printf '  - %-10s %s\n' "$p" "$(usage_of "$CRED.$p")"
    fi
  done
  exit 0
fi

profiles | grep -Fqx "$name" || die "unknown profile: $name (saved profiles: $(profiles | tr '\n' ' '))"
target="$name"

# 1) Refuse to switch if Claude Code is running (it rewrites .claude.json, clobbering the swap)
procs=$(claude_procs)
if [ -n "$procs" ]; then
  echo "✗ Claude Code is running. Quit it fully before switching profiles:" >&2
  echo "$procs" | sed 's/^/    /' >&2
  exit 1
fi
[ -f "$CONF" ] || die "config not found: $CONF"

# 2) Write the live account back to the profile that owns it (preserves refreshed tokens)
live_uuid=$(uuid_of "$CONF")
owner=""
if [ -n "$live_uuid" ]; then
  owner=$(profile_of_uuid "$live_uuid") \
    || die "current account ($(email_of "$CONF")) is not saved in any profile; run '$prog --save <name>' first"
  json_op extract "$CONF" "$CONF.$owner"
  [ -f "$CRED" ] && copy_atomic "$CRED" "$CRED.$owner"
fi
if [ "$owner" = "$target" ]; then
  echo "$target" > "$MARK"
  echo "✓ already on [$target]  ($(email_of "$CONF"))"
  exit 0
fi

# 3) Load the target account (only oauthAccount + credentials; all other settings stay as they are)
json_op apply "$CONF.$target" "$CONF"
copy_atomic "$CRED.$target" "$CRED"
echo "$target" > "$MARK"
echo "✓ switched to [$target]  ($(email_of "$CONF"))"
